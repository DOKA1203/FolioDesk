<Window x:Class="FolioDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolioDesk"
        Title="FolioDesk"
        Width="420" Height="210"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- FolioDesk palette -->
        <SolidColorBrush x:Key="DeepNavyBrush" Color="#17213A"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2257E6"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#FF654F"/>
        <SolidColorBrush x:Key="IvoryBrush" Color="#F4F0E6"/>

        <Style x:Key="WindowActionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource DeepNavyBrush}"/>
            <Setter Property="Background" Value="#0D17213A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1817213A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Width="28" Height="28"
                                        CornerRadius="9" Background="#25FFFFFF">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0,6 L12,6 M6,0 L6,12"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3167F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="28" Background="{StaticResource IvoryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.32" Color="#071022"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid Margin="24,18,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable title bar -->
                <Grid Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FolioDesk" Foreground="{StaticResource DeepNavyBrush}"
                                       FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource LangToggle}"
                                Style="{StaticResource WindowActionButton}"
                                FontSize="10" FontWeight="Bold"
                                Click="ToggleLang_Click" ToolTip="Language"/>
                        <Button Style="{StaticResource WindowActionButton}"
                                Click="CheckUpdate_Click" ToolTip="GitHub Releases">
                            <Viewbox Width="14" Height="14">
                                <Path Fill="{StaticResource DeepNavyBrush}"
                                      Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource WindowActionButton}"
                                Click="CloseButton_Click" ToolTip="Close">
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{StaticResource DeepNavyBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0,0 L10,10 M10,0 L0,10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Primary action -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid Width="218" VerticalAlignment="Center">
                        <Border Margin="7,7,0,0" Height="54" CornerRadius="15"
                                Background="{StaticResource CoralBrush}" Opacity="0.28"/>
                        <Button Content="{DynamicResource NewFolder}"
                                Margin="0,0,7,7" Style="{StaticResource CreateButton}"
                                Click="CreateFolder"/>
                    </Grid>

                    <TextBlock Text="{x:Static local:App.Version}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="#8A8790" FontSize="9.5"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
